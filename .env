# AutoMex Backend Environment Variables
# Copy this file to .env and update with your actual values

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/automex

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
# Add your frontend URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ImageKit Configuration
# Get these from https://imagekit.io/dashboard
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIA45MCZ6J7********
AWS_SECRET_ACCESS_KEY=****************************************
AWS_REGION=ap-south-2
AWS_BUCKET_NAME=automex-bhubaneswar
AWS_S3_FOLDER=Backend/my-cars/

# EmailJS Configuration
EMAILJS_PUBLIC_KEY=QB9CD3fOj37cvnhsr
EMAILJS_PRIVATE_KEY=*********************
EMAILJS_SERVICE_ID=service_akqns69
